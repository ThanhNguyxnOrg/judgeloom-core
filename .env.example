# =============================================================================
# JudgeLoom — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only trust X-Forwarded-For when a reverse proxy overwrites it and its IP is listed.
TRUST_X_FORWARDED_FOR=False
TRUSTED_PROXY_IPS=

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgres://judgeloom:judgeloom@localhost:5432/judgeloom
POSTGRES_DB=judgeloom
POSTGRES_USER=judgeloom
POSTGRES_PASSWORD=change-me-to-a-random-password

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CHANNEL_LAYERS_URL=redis://localhost:6379/2

# ─── Email ──────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@judgeloom.dev

# ─── Storage ────────────────────────────────────────────────────────────────
MEDIA_ROOT=/var/judgeloom/media
STATIC_ROOT=/var/judgeloom/static

# ─── Judge ──────────────────────────────────────────────────────────────────
JUDGE_BRIDGE_HOST=localhost
JUDGE_BRIDGE_PORT=9999
JUDGE_BRIDGE_SECRET=change-me-to-a-random-string

# ─── Judge worker ───────────────────────────────────────────────────────────
# Create with: python manage.py create_judge_token <name>
JUDGELOOM_JUDGE_TOKEN=change-me-to-a-random-token
JUDGELOOM_JUDGE_NAME=judge-worker-1
GO_JUDGE_URL=http://localhost:5050
WORKER_LANGUAGES=PY3,CPP17
WORKER_CACHE_DIR=./worker-cache

# ─── OAuth (optional) ──────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── Monitoring (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
# Required by the production compose overlay; use a strong user:password pair.
FLOWER_BASIC_AUTH=flower:change-me
