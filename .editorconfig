# =============================================================================
# JudgeLoom — EditorConfig
# =============================================================================
# Top-most EditorConfig file
# Docs: https://editorconfig.org/
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ─── Python ──────────────────────────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 120

# ─── Web / config / docs (2-space convention) ────────────────────────────────
[*.{yml,yaml,json,toml,html,css,scss,js,jsx,ts,tsx,vue,md}]
indent_size = 2

# ─── Makefile requires real tabs ─────────────────────────────────────────────
[Makefile]
indent_style = tab

# ─── Windows-only files ──────────────────────────────────────────────────────
[*.{bat,cmd,ps1}]
end_of_line = crlf
