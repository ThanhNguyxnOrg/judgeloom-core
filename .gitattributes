# =============================================================================
# JudgeLoom — Git attributes
# =============================================================================
# Normalise line endings and mark binary / generated files for Git.
# Docs: https://git-scm.com/docs/gitattributes
# =============================================================================

# Default: auto-detect text files and normalise to LF on commit
* text=auto eol=lf

# ─── Source ──────────────────────────────────────────────────────────────────
*.py        text eol=lf diff=python
*.pyi       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.rst       text eol=lf
*.txt       text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# ─── Windows-specific files keep CRLF ────────────────────────────────────────
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ─── Binary assets ───────────────────────────────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.webp      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.mp3       binary
*.mp4       binary

# ─── Files excluded from GitHub language stats / archives ────────────────────
docs/**            linguist-documentation
**/migrations/**   linguist-generated=true
*.lock             linguist-generated=true
poetry.lock        linguist-generated=true
package-lock.json  linguist-generated=true

# ─── Files excluded from `git archive` ──────────────────────────────────────
.github/           export-ignore
.gitattributes     export-ignore
.gitignore         export-ignore
.editorconfig      export-ignore
.pre-commit-config.yaml export-ignore
docker-compose*.yml     export-ignore
docker/                  export-ignore
tests/                   export-ignore
docs/                    export-ignore
